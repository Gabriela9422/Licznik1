<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Licznik.Views.LicznikPage"
             Title="LicznikPage">
    <ScrollView>
        <VerticalStackLayout Padding="30"
                             Spacing="20">
            
            <Label Text="Liczniki"
                   FontSize="30"
                   HorizontalOptions="Center" />

            <Entry x:Name="NazwaEntry"
                   Placeholder="Nazwa licznika" />

            <Button Text="Dodaj licznik"
                    Clicked="Dodaj_Clicked" />

            <VerticalStackLayout x:Name="LicznikiLayout"
                                 Spacing="20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>